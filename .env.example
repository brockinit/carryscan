# Local docker-compose defaults — for Vercel use a remote (non-localhost) URL
DATABASE_URL=postgresql://carryscan:carryscan@localhost:5432/carryscan

# Cash closes / quotes (Polygon / Massive)
MASSIVE_API_KEY=

# Hyperliquid
HL_INFO_URL=https://api.hyperliquid.xyz/info
# Optional: public address for clearinghouseState margin / liq strip
HL_WATCH_ADDRESS=

# IBKR Flex Web Service (Borrow Fee Details query)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Optional CSV blotter when Flex has no row (defaults to db/seed/borrow.csv)
# BORROW_CSV=/path/to/borrow.csv

# Public site URL (weekly generator / links)
PUBLIC_BASE_URL=http://localhost:3000

# Optional earnings CSV override (defaults to db/seed/earnings.csv)
# EARNINGS_CSV=
